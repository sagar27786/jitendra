{
  "version": 2,
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/jitendra_portfolio_v3", "dest": "/jitendra_portfolio_v3.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
